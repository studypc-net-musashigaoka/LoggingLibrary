{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "logging-core Configuration",
  "type": "object",
  "properties": {
    "root": {
      "$ref": "#/definitions/root",
      "description": "ルートロガー"
    },
    "loggers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/logger"
      },
      "description": "ロガー"
    },
    "ttl": {
      "type": "number",
      "description": "ログ出力レベルのキャッシュ有効期間[ミリ秒]",
      "minimum": 0
    }
  },
  "definitions": {
    "level": {
      "type": "string",
      "enum": [
        "all", "verbose", "trace", "debug", "info", "notice", "warn", "error", "severe", "critical", "alert", "fatal", "emergency", "off"
      ],
      "description": "ログレベル"
    },
    "root": {
      "type": "object",
      "properties": {
        "level": { "$ref": "#/definitions/level" },
        "appenders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/appender"
          }
        }
      },
      "required": ["level", "appenders"]
    },
    "logger": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "level": { "$ref": "#/definitions/level" },
        "appenders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/appender"
          }
        }
      },
      "required": ["name", "level", "appenders"]
    },
    "appender": {
      "type": "object",
      "properties": {
        "type": { "$ref": "#/definitions/appender-type" }
      },
      "description": "ログ出力実体",
      "required": ["type"]
    },
    "appender-type": {
      "type": "string",
      "description": "ログ出力ロジック(別途拡張)",
      "minLength": 1
    }
  }
}
